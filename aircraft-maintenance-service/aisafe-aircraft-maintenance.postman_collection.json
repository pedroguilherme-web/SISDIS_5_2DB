		"name": "AISafe - Aircraft & Maintenance Component (Assignment 1 - 3 Instances)",
		"description": "Comprehensive test collection demonstrating:\n1. Authentication (JWT token issuance)\n2. Local data access on Instance 1 (:8081)\n3. Peer-to-Peer HTTP GET Forwarding across 3 Replicas (:8081 -> :8082 -> :8083)\n4. Resilience & Error Handling (404 and offline peers)\n5. Loop prevention via X-Peer-Forwarded header",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "instance1_url",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "instance2_url",
			"value": "http://localhost:8082",
			"type": "string"
		},
		{
			"key": "instance3_url",
			"value": "http://localhost:8083",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Authentication",
			"item": [
				{
					"name": "Login as ATCC Operator (Instance 1)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set('jwt_token', jsonData.token);",
									"console.log('JWT Token saved: ' + jsonData.token);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"atcc\",\n    \"password\": \"atcc123\"\n}"
						},
						"url": {
							"raw": "{{instance1_url}}/api/auth/login",
							"host": ["{{instance1_url}}"],
							"path": ["api", "auth", "login"]
						}
					}
				}
			]
		},
