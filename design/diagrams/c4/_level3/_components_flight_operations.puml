@startuml _components_flight_operations
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title Component Diagram - Flight Operations Service (C4 Level 3, Assignment 2: CQRS + AMQP)

Container_Ext(spa, "Web Client / Postman", "HTTP REST", "Commands on /api/flights, queries on /api/v2/flights and /api/v2/unicorns.")
Container_Ext(peer_instance, "Peer Replica", "Flight Operations (Port 8072)", "Owns its own partition of the write model and a full copy of the read model.")
Container_Ext(aircraft_service, "Aircraft & Maintenance Service", "Spring Boot (8081-8083)", "Publishes aircraft.registered / aircraft.status.changed; consumes flight.completed.")
Container_Ext(route_service, "Airports & Routes Service", "Spring Boot (8092-8093)", "Publishes routes.route.changed on aisafe.routes.events.")
ContainerQueue_Ext(broker, "RabbitMQ", "AMQP 0-9-1", "Topic exchanges aisafe.exchange and aisafe.routes.events; one durable queue set per replica.")

Container_Boundary(fo_container, "Flight Operations Service Container [Port 8071]") {

    Component(security_filter, "Security Filter Chains", "Spring Security / JWT", "Shared chain for client endpoints; FlightSecurityConfig for status changes, inter-service endpoints and /api/v2.")

    Component(command_api, "FlightController", "Spring MVC", "Commands: schedule, change status, CSV import (+ v1 reads kept for compatibility).")
    Component(stats_api, "FlightStatisticsController", "Spring MVC", "v1 inter-service contract: hours, exists, timeline, top-models, count, conflicts.")
    Component(query_api, "FlightQueryController + UnicornsController", "Spring MVC", "CQRS query API /api/v2/flights and /api/v2/unicorns.")

    Component(usecases, "Command Use Cases", "@UseCase (transactional, audited)", "ScheduleFlight, ChangeFlightStatus, ImportFlights. Publish a FlightEvent after saving.")
    Component(domain, "Domain", "Plain Java", "ScheduledFlight (UUID, lifecycle, revision), FlightStatus transitions.")
    Component(write_repo, "Write Model Repository", "Spring Data JPA", "scheduled_flight (aircraft owned by this replica) + per-aircraft lock row (SELECT ... FOR UPDATE).")

    Component(dispatcher, "FlightEventDispatcher", "Transactional outbox", "Writes the messages to outbox_message in the command transaction; after commit projects locally and triggers the relay.")
    Component(relay, "OutboxRelay", "@Scheduled + publisher confirms", "Publishes pending outbox messages in order; retries every 2 s while the broker is down.")
    Component(ownership, "HashFlightOwnership", "hash(registration) mod replicas", "Picks the replica that owns each aircraft; commands for other aircraft are forwarded to their owner.")
    Component(listeners, "EventListeners", "@RabbitListener", "Consumes flight events of other replicas, aircraft events, route events.")
    Component(projector, "FlightProjector", "Idempotent by revision", "Updates flight_read_model and aircraft_activity_read_model (incl. mood).")
    Component(query_service, "FlightQueryService", "Read-only", "Reads only the read-model tables.")
    Component(rebuilder, "ReadModelRebuilder", "shared-core P2P search", "Rebuilds the read model from the write models of the cluster (startup / on demand).")

    Component(catalog, "Catalog clients", "Local catalog + HTTP fallback", "aircraft_catalog and route_catalog fed by events; HTTP with failover only when missing or old.")

    ContainerDb(local_db, "Instance H2 Database", "Database-per-instance", "Write tables, read-model tables and catalogs of this replica only.")
}

Rel(spa, security_filter, "REST", "JSON / HTTP(S)")
Rel(security_filter, command_api, "Commands")
Rel(security_filter, query_api, "Queries")
Rel(aircraft_service, stats_api, "GET hours, exists...", "HTTP")

Rel(command_api, usecases, "Invokes")
Rel(usecases, domain, "Creates / changes")
Rel(usecases, write_repo, "Saves")
Rel(usecases, catalog, "Aircraft / route checks")
Rel(usecases, dispatcher, "FlightEvent (port)")
Rel(dispatcher, projector, "In-process, after commit")
Rel(dispatcher, relay, "Triggers after commit")
Rel(relay, broker, "Publishes (confirmed)", "AMQP")
Rel(usecases, ownership, "Who owns the aircraft?")
Rel(usecases, peer_instance, "Forward schedule to the owner", "HTTP")
Rel(broker, listeners, "Delivers (per-replica queues)", "AMQP")
Rel(listeners, projector, "Flight / aircraft events")
Rel(listeners, catalog, "Aircraft / route events")
Rel(query_api, query_service, "Reads")
Rel(query_api, rebuilder, "Rebuild")
Rel(rebuilder, peer_instance, "POST /api/p2p/search", "HTTP + peer JWT")
Rel(catalog, aircraft_service, "Fallback GET /api/aircrafts/{reg}", "HTTP")
Rel(catalog, route_service, "Fallback GET /api/routes/{o}/{d}", "HTTP")
Rel(aircraft_service, broker, "aircraft.* events", "AMQP")
Rel(route_service, broker, "routes.* events", "AMQP")
Rel(broker, aircraft_service, "flight.completed", "AMQP")
Rel(write_repo, local_db, "JDBC")
Rel(projector, local_db, "JDBC")
Rel(query_service, local_db, "JDBC")
@enduml
