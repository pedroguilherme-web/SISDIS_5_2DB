
@startuml
title Distributed Airport Search - P2P Architecture

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "API Client" as Client

node "Airports & Routes Service\nPeer 1 - Port 8082" as Peer1 {
    component "P2PSearchController" as Controller1
    component "PeerAuthenticationFilter" as Auth1
    component "DistributedSearchService" as Search1
    component "AirportLocalSearchProvider" as Local1
    component "PeerRegistry" as Registry1
    component "PeerClient" as Client1
    component "PeerTokenService" as Token1

    Controller1 --> Search1
    Search1 --> Local1 : Local search
    Search1 --> Registry1 : Discover peers
    Search1 --> Client1 : Forward request
    Client1 --> Token1 : Generate JWT
}

node "Airports & Routes Service\nPeer 2 - Port 8083" as Peer2 {
    component "PeerAuthenticationFilter" as Auth2
    component "P2PSearchController" as Controller2
    component "DistributedSearchService" as Search2
    component "AirportLocalSearchProvider" as Local2
    component "PeerRegistry" as Registry2
    component "PeerClient" as Client2
    component "PeerTokenService" as Token2

    Controller2 --> Search2
    Search2 --> Local2 : Local search
    Search2 --> Registry2 : Discover peers
    Search2 --> Client2 : Forward request
    Client2 --> Token2 : Generate JWT
}

Client --> Auth1 : HTTP POST /api/p2p/search\nBearer JWT
Auth1 --> Controller1 : Authorized request

Client1 --> Auth2 : HTTP POST /api/p2p/search\nBearer JWT + TTL
Auth2 --> Controller2 : Authorized request

note bottom of Peer1
Each peer runs its own service instance.
P2P infrastructure is provided by shared-core.
end note

note bottom of Peer2
Distributed searches combine local
and remote JSON responses.
end note

@enduml
